# NovaBite AI Restaurant Assistant - Environment Variables
# Copy this file to .env and fill in your actual values

# Required: OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: LLM Model (defaults to gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# Optional: Embedding Model (defaults to text-embedding-ada-002)
EMBEDDING_MODEL=text-embedding-ada-002

# Optional: RAG Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=4
RETRIEVAL_SCORE_THRESHOLD=0.75

# Optional: Agent Settings
MAX_ITERATIONS=5
TEMPERATURE=0.1

# Optional: API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Optional: Feature Flags
VERBOSE=false
