# NovaBite AI Restaurant Assistant - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================
# LLM PROVIDER SELECTION
# ============================================================
# Options: "openai" or "openrouter"
# - "openai": Use OpenAI directly (requires OPENAI_API_KEY)
# - "openrouter": Use OpenRouter for cheaper/faster inference (requires OPENROUTER_API_KEY + OPENAI_API_KEY for embeddings)
LLM_PROVIDER=openai

# ============================================================
# OpenAI Configuration (Required for embeddings, optional for LLM)
# Get yours at: https://platform.openai.com/api-keys
# ============================================================
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter Configuration (Only needed if LLM_PROVIDER=openrouter)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ============================================================
# Model Selection
# ============================================================
# For OpenAI: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# For OpenRouter: openai/gpt-4o-mini, anthropic/claude-3-haiku, meta-llama/llama-3-8b-instruct, etc.
LLM_MODEL=gpt-4o-mini

# Optional: Embedding Model (defaults to text-embedding-ada-002)
EMBEDDING_MODEL=text-embedding-ada-002

# Optional: RAG Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=4
RETRIEVAL_SCORE_THRESHOLD=0.75

# Optional: Agent Settings
MAX_ITERATIONS=5
TEMPERATURE=0.1

# Optional: API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Optional: Feature Flags
VERBOSE=false
