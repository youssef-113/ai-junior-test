# Docker ignore file for NovaBite
# Prevents unnecessary files from being copied into the Docker image

# Git
.git
.gitignore
.gitattributes

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment files (contains secrets)
.env
.env.local
.env.*.local

# Test files
tests/
.pytest_cache/
.coverage
htmlcov/

# Documentation
*.md
docs/

# Docker files themselves (not needed in image)
Dockerfile
docker-compose.yml
.dockerignore

# FAISS index (will be generated or mounted)
data/faiss_index/

# Logs
*.log
logs/
